# Don't track final .pptx or .pdf exports as a class (can be large)
*.pptx
*.pdf
# Keep this .gitignore tracked
!.gitignore
# Exception: appendix deliverables (committed alongside their build script
# for reproducibility and so reviewers can open them directly from the repo
# without re-running the builder).
# v1 (18 slides) + v2 (20 slides) + v3 (21 slides — A5 added) + v4 (21 slides
# — SVG phospho-in-Phase-1 correction) preserved as historical artifacts;
# v5 (21 slides — Step 5 unified reconciliation: speaker notes glossary
# embedding + remaining stale-reference cleanup) is the current deliverable.
!aivc_appendix_v1.pptx
!aivc_appendix_v2.pptx
!aivc_appendix_v3.pptx
!aivc_appendix_v4.pptx
!aivc_appendix_v5.pptx
!aivc_investor_4slide_v1.pptx
!aivc_investor_4slide_v1_1.pptx
!aivc_investor_4slide_v3.pptx
!aivc_investor_4slide_v1_1.pptx
!aivc_mechanica_v1.pptx
!aivc_architecture_v1.pptx
!aivc_seed_plan_v1.pptx
